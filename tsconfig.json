{
  "compilerOptions": {
    "target": "ES2020",
    "module": "es6",

    "rootDir": "./",
    "outDir": "./dist",

    "strict": true,
    "allowJs": true,
    "checkJs": false,

    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,

    "sourceMap": true,
    "declaration": false
  },

  "include": [
    "BackEnd/**/*.js",
    "FrontEnd/**/*.js",
    "BackEnd/**/*.ts",
    "FrontEnd/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}
